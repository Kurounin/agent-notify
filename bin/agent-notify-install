#!/usr/bin/env zsh

unsetopt xtrace verbose
setopt errexit no_unset pipe_fail

typeset root=${0:A:h:h}
source "$root/lib/agent-notify/config.zsh"
source "$root/lib/agent-notify/version.zsh"
typeset -r keychain_account='agent-notify'
typeset -r keychain_selector_service="$AGENT_NOTIFY_KEYCHAIN_SELECTOR_SERVICE"

typeset install_home=${AGENT_NOTIFY_INSTALL_HOME:-$HOME}
typeset security_bin=${AGENT_NOTIFY_INSTALL_SECURITY_BIN:-$AGENT_NOTIFY_SECURITY_BIN}
typeset jxa_bin=${AGENT_NOTIFY_INSTALL_JXA_BIN:-$AGENT_NOTIFY_JXA_BIN}
typeset curl_bin=${AGENT_NOTIFY_INSTALL_CURL_BIN:-/usr/bin/curl}
typeset keychain_helper=${AGENT_NOTIFY_INSTALL_KEYCHAIN_HELPER:-$root/installer/keychain.jxa}
typeset settings_helper=${AGENT_NOTIFY_INSTALL_SETTINGS_HELPER:-$root/installer/claude-settings.jxa}
typeset manifest_helper=${AGENT_NOTIFY_INSTALL_MANIFEST_HELPER:-$root/installer/manifest.jxa}
typeset plugin_helper=${AGENT_NOTIFY_INSTALL_PLUGIN_HELPER:-$root/installer/opencode-plugin.jxa}
typeset install_bin="$install_home/.local/bin/agent-notify"
typeset install_lib="$install_home/.local/lib/agent-notify"
typeset claude_hook_path="$install_home/.local/bin/agent-notify-claude-hook"
typeset claude_hook_jxa_path="$install_home/.local/bin/agent-notify-claude-hook.jxa"
typeset plugin_path="$install_home/.config/opencode/plugins/agent-notify.js"
typeset settings_path="$install_home/.claude/settings.json"
typeset state_dir="$install_home/Library/Application Support/agent-notify"
typeset manifest_path="$state_dir/install-manifest.json"
typeset settings_conf_path="$state_dir/$AGENT_NOTIFY_SETTINGS_FILE_NAME"
typeset backup_root="$state_dir/install-backups"
typeset command_prefix="$claude_hook_path"
typeset dry_run=0 rollback=0 backup_dir='' preflight_stage='' generation='' selector_before='' backup_root_created=0 state_dir_existed=0
typeset user_key='' app_token='' settings_existed=0 bin_existed=0 lib_existed=0 hook_existed=0 hook_jxa_existed=0 plugin_existed=0
typeset bin_post_hash='' lib_post_hash='' hook_post_hash='' hook_jxa_post_hash='' plugin_post_hash='' settings_post_hash='' manifest_post_hash='' manifest_existed=0 mutation_started=0 completed=0 attempt_restored=0 secret_prompt_open=0
typeset -a attempt_created_dirs
typeset -A unavailable_links

usage() { print -u2 -- 'usage: agent-notify-install [--dry-run|--rollback]'; }
die() { print -u2 -- "agent-notify-install: $*"; exit 1; }
sha256() { /usr/bin/shasum -a 256 "$1" | /usr/bin/awk '{print $1}'; }
mode() { /usr/bin/stat -L -f '%Lp' "$1"; }
command_path() { command -v "$1" 2>/dev/null || true; }

probe_keychain() {
  "$security_bin" find-generic-password -a "$keychain_account" -s "$1" >/dev/null 2>&1
}

read_tty() {
  local prompt=$1 value
  if [[ -n ${AGENT_NOTIFY_INSTALL_TEST_INPUT:-} ]]; then
    value=${(s.:.)AGENT_NOTIFY_INSTALL_TEST_INPUT}[1]
    AGENT_NOTIFY_INSTALL_TEST_INPUT=${AGENT_NOTIFY_INSTALL_TEST_INPUT#*:}
    REPLY=$value
    return 0
  fi
  [[ -r /dev/tty ]] || return 1
  print -n -u2 -- "$prompt"
  IFS= read -r value </dev/tty || return 1
  REPLY=$value
}

read_secret_tty() {
  local prompt=$1 value
  if [[ -n ${AGENT_NOTIFY_INSTALL_TEST_INPUT_FD:-} ]]; then
    IFS= read -ru "$AGENT_NOTIFY_INSTALL_TEST_INPUT_FD" value || return 1
    REPLY=$value
    return 0
  fi
  [[ -r /dev/tty ]] || return 1
  secret_prompt_open=1
  # A stty killed after it applied the mode also fails, so echo is turned back on here.
  /bin/stty -echo </dev/tty || { /bin/stty echo </dev/tty 2>/dev/null; secret_prompt_open=0; return 1; }
  # With nobody reading the prompt, SIGPIPE would otherwise end the installer with echo off.
  trap stop_before_mutation PIPE
  print -n -u2 -- "$prompt"
  trap - PIPE
  IFS= read -r value </dev/tty || { /bin/stty echo </dev/tty; secret_prompt_open=0; return 1; }
  /bin/stty echo </dev/tty
  secret_prompt_open=0
  print -u2 -- ''
  REPLY=$value
}

# Nothing is installed yet, so a signal can simply stop the installer, and the EXIT trap removes what the attempt staged. Two things would skip that trap: exiting with errexit on when the signal interrupted a child inside a function, and SIGPIPE from the message below, since a ^C also kills a reader such as tee.
stop_before_mutation() {
  set +e
  trap '' HUP INT TERM PIPE
  (( secret_prompt_open )) && /bin/stty echo </dev/tty 2>/dev/null
  print -u2 -- ''
  print -u2 -- 'agent-notify-install: interrupted before installing anything'
  exit 1
}

tree_hash() {
  [[ -d $1 ]] || { print -- '-'; return; }
  (cd "$1" && /usr/bin/find . -type f -print | /usr/bin/sort | while IFS= read -r file; do print -- "$file"; /usr/bin/shasum -a 256 "$file"; done) | /usr/bin/shasum -a 256 | /usr/bin/awk '{print $1}'
}

confirm() {
  local question=$1
  if [[ -n ${AGENT_NOTIFY_INSTALL_TEST_CONFIRM_SEQUENCE:-} ]]; then
    local answer=${AGENT_NOTIFY_INSTALL_TEST_CONFIRM_SEQUENCE%%:*}
    AGENT_NOTIFY_INSTALL_TEST_CONFIRM_SEQUENCE=${AGENT_NOTIFY_INSTALL_TEST_CONFIRM_SEQUENCE#*:}
    [[ $answer == yes ]]
    return
  fi
  if [[ ${AGENT_NOTIFY_INSTALL_TEST_CONFIRM:-} == yes ]]; then return 0; fi
  read_tty "$question [y/N] " || return 1
  [[ $REPLY == [yY] || $REPLY == [yY][eE][sS] ]]
}

version_from() {
  local output=$1
  [[ $output =~ '([0-9]+\.[0-9]+(\.[0-9]+)?)' ]] || return 1
  REPLY=$match[1]
}

preflight() {
  local macos claude_bin opencode_bin version
  [[ ${AGENT_NOTIFY_INSTALL_SKIP_PLATFORM_CHECK:-0} == 1 ]] || [[ $(/usr/bin/uname -s) == Darwin ]] || die 'macOS is required'
  for tool in "$security_bin" "$jxa_bin" "$curl_bin" /usr/bin/shasum /usr/bin/mktemp /bin/cp /bin/mkdir /bin/chmod /bin/mv /bin/ln /usr/bin/readlink /usr/bin/find /usr/bin/sort; do
    [[ -x $tool ]] || die "required executable unavailable: $tool"
  done
  claude_bin=${AGENT_NOTIFY_INSTALL_CLAUDE_BIN:-$(command_path claude)}
  opencode_bin=${AGENT_NOTIFY_INSTALL_OPENCODE_BIN:-$(command_path opencode)}
  [[ -n $claude_bin && -x $claude_bin ]] || die 'supported Claude Code installation unavailable'
  [[ -n $opencode_bin && -x $opencode_bin ]] || die 'supported OpenCode installation unavailable'
  macos=${AGENT_NOTIFY_INSTALL_MACOS_VERSION:-$(/usr/bin/sw_vers -productVersion)}
  agent_notify_validate_version macos "$macos" || die "unsupported macOS version: $macos"
  version_from "$("$claude_bin" --version 2>/dev/null)" || die 'unparseable Claude Code version'
  agent_notify_validate_version claude-code "$REPLY" || die "unsupported Claude Code version: $REPLY"
  agent_notify_opencode_version_token "$("$opencode_bin" --version 2>/dev/null)" || die 'unparseable OpenCode version'
  agent_notify_validate_version opencode "$REPLY" || die "unsupported OpenCode version: $REPLY"
  [[ -x $root/bin/agent-notify && -d $root/lib/agent-notify && -r $root/integrations/opencode/agent-notify.js && -r $root/integrations/claude/agent-notify-hook.zsh && -r $root/integrations/claude/agent-notify-hook.jxa ]] || die 'repository installation sources are incomplete'
  [[ -r $keychain_helper && -r $settings_helper && -r $plugin_helper && -r $manifest_helper ]] || die 'installer helper unavailable'
  if [[ -e $settings_path ]]; then
    settings_existed=1
    [[ $("$jxa_bin" -l JavaScript "$settings_helper" inspect "$settings_path" - "$command_prefix") == valid ]] || die 'Claude settings are unparseable; no changes made'
  fi
  preflight_stage=$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/agent-notify-preflight.XXXXXX") || die 'unable to stage installation artifacts'
  /bin/cp "$root/bin/agent-notify" "$preflight_stage/agent-notify" || die 'unable to stage notifier'
  stage_plugin "$preflight_stage/agent-notify.js" || die 'unable to stage OpenCode plugin'
  "$jxa_bin" -l JavaScript "$settings_helper" merge "$settings_path" "$preflight_stage/settings.json" "$command_prefix" || die 'unable to stage Claude settings'
  [[ $("$jxa_bin" -l JavaScript "$settings_helper" inspect "$preflight_stage/settings.json" - "$command_prefix") == valid ]] || die 'generated Claude settings failed validation'
  /bin/rm -rf "$preflight_stage" || die 'unable to clean staged artifacts'
  preflight_stage=''
  find_unavailable_links
}

# A link whose target cannot be reached looks absent to [[ -e ]] and fileExistsAtPath, so an install would replace it with no backup and no mention.
find_unavailable_links() {
  local target text
  for target in "$install_bin" "$install_lib" "$claude_hook_path" "$claude_hook_jxa_path" "$plugin_path" "$settings_path" "$manifest_path"; do
    if [[ -L $target && ! -e $target ]]; then
      # The x keeps trailing newlines, which $(...) would strip from the text a failed attempt has to recreate.
      text=$(/usr/bin/readlink -n "$target" && print -n x) || die "unable to read the link at $target; no changes made"
      unavailable_links[$target]=${text%x}
    fi
  done
}

cleanup_attempt() {
  (( completed )) && return 0
  [[ -n $preflight_stage && -d $preflight_stage ]] && /bin/rm -rf "$preflight_stage"
  # The backup keeps the modes it copied, and a read-only directory there would stop it being removed. The steps after a restore rely on it being gone.
  [[ -n $backup_dir && -d $backup_dir ]] && { /bin/chmod -R u+rwx "$backup_dir" || true; /bin/rm -rf "$backup_dir"; }
  (( backup_root_created )) && [[ -d $backup_root ]] && /bin/rmdir "$backup_root" 2>/dev/null || true
  local directory
  for directory in ${(Oa)attempt_created_dirs}; do /bin/rmdir "$directory" 2>/dev/null || true; done
}

mark_new_directory() {
  [[ -d $1 ]] || attempt_created_dirs+=("$1")
}

manifest_field() { "$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" "$1" 2>/dev/null; }

rollback_preflight() {
  [[ -x $jxa_bin ]] || die "required executable unavailable: $jxa_bin"
  [[ -r $manifest_path ]] || die 'no installation manifest found'
  local backup label expected backup_name recorded post_hash existed
  backup=$(manifest_field backup) || die 'installation manifest is invalid; no changes made'
  [[ ${backup:h} == "$backup_root" && ${backup:t} == install.* ]] || die 'recorded backup directory is not under the backup location for this home; no changes made'
  for label expected backup_name in binary "$install_bin" agent-notify library "$install_lib" lib hook "$claude_hook_path" agent-notify-claude-hook hook_jxa "$claude_hook_jxa_path" agent-notify-claude-hook.jxa plugin "$plugin_path" agent-notify.js settings "$settings_path" settings.json; do
    recorded=$(manifest_field "files.$label.path") && [[ $recorded == "$expected" ]] || die "recorded path for $label is not the managed path for this home; no changes made"
    post_hash=$(manifest_field "files.$label.post_hash") && [[ $post_hash =~ '^[0-9a-f]{64}$' ]] && existed=$(manifest_field "files.$label.existed") || die "installation manifest entry for $label is invalid; no changes made"
    # cp -pR keeps a library link as a link, which may not resolve from the backup directory. File backups are never links.
    [[ $existed == true && ( -e $backup/$backup_name || $label == library && -L $backup/$backup_name ) || $existed == false && ! -e $backup/$backup_name ]] || die "backup of $label does not match the manifest; no changes made"
    # The library is restored with cp -pR and has no modes entry.
    [[ $label == library || $existed == false ]] || /usr/bin/grep -Eqs "^$backup_name [0-7]{1,4}$" "$backup/modes" || die "backup of $label has no recorded mode; no changes made"
  done
}

classify_file() {
  local target=$1 source=$2 label=$3
  (( ${+unavailable_links[$target]} )) && { print -- "$label: conflict"; return; }
  [[ -e $target ]] || { print -- "$label: absent"; return; }
  if [[ $(sha256 "$target") == $(sha256 "$source") ]]; then print -- "$label: installer-managed exact"; else print -- "$label: conflict"; fi
}

plugin_is_managed() {
  local first_line recorded_hash
  [[ -e $plugin_path ]] || return 1
  IFS= read -r first_line < "$plugin_path"
  [[ $first_line == '// >>> agent-notify managed plugin >>>' && -r $manifest_path ]] || return 1
  recorded_hash=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.plugin.post_hash 2>/dev/null) || return 1
  [[ $(sha256 "$plugin_path") == $recorded_hash ]]
}

has_conflict() {
  (( ${#unavailable_links} )) && return 0
  [[ -e $install_bin && $(sha256 "$install_bin") != $(sha256 "$root/bin/agent-notify") ]] && return 0
  [[ -e $install_lib && ! -d $install_lib ]] && return 0
  [[ -d $install_lib && $(tree_hash "$install_lib") != $(tree_hash "$root/lib/agent-notify") ]] && return 0
  [[ -e $claude_hook_path && $(sha256 "$claude_hook_path") != $(sha256 "$root/integrations/claude/agent-notify-hook.zsh") ]] && return 0
  [[ -e $claude_hook_jxa_path && $(sha256 "$claude_hook_jxa_path") != $(sha256 "$root/integrations/claude/agent-notify-hook.jxa") ]] && return 0
  [[ -e $plugin_path ]] && ! plugin_is_managed && return 0
  return 1
}

preview() {
  print -- 'agent-notify installation plan (no changes have been made):'
  print -- "  executable: $install_bin"
  print -- "  notifier library: $install_lib"
  print -- "  Claude hook adapter: $claude_hook_path"
  print -- "  OpenCode plugin: $plugin_path"
  print -- "  Claude settings: $settings_path (managed hooks only)"
  print -- "  Claude hook JXA: $claude_hook_jxa_path"
  print -- "  Keychain services: ${AGENT_NOTIFY_KEYCHAIN_USER_SERVICE_PREFIX}<generation>, ${AGENT_NOTIFY_KEYCHAIN_TOKEN_SERVICE_PREFIX}<generation>, $keychain_selector_service"
  print -- '  Keychain migration: creates independent v2 credentials; legacy v1 items are not read, changed, or removed.'
  print -- '  Keychain migration requires entering new Pushover credentials after confirmation.'
  print -- "  backups: $backup_root/<unique>/ (0700 directory; 0600 files)"
  print -- "  excerpt settings: $settings_conf_path (created only if absent; never overwritten by a reinstall)"
  print -- "  Pushover and downstream push services receive agent name, a sanitized and bounded tmux-or-project display context, normalized state, and, when enabled and available, a sanitized bounded single-line excerpt."
  print -- "  When tmux is detected, the Claude adapter automatically performs a bounded lookup for the originating pane; a valid result uses its current innermost session name, otherwise the project basename is used."
  print -- "  OpenCode always uses the resolved session-directory project basename: its shared-server environment does not establish an originating pane, and this V2 adapter does not discover panes or perform tmux lookup."
  print -- "  Tmux is optional; its user-chosen innermost session name can be sensitive."
  print -- "  Claude completion excerpts use final assistant output; Claude failure excerpts use the categorical error identifier, never free-text error detail. OpenCode completion excerpts use relevant root-session assistant text available through native context; OpenCode failure excerpts use structured error message when present or error type otherwise, never response bodies. Excerpts are sanitized and bounded: the selected source is sent in full when it already fits the bound and truncated when longer; model output or OpenCode error messages can repeat sensitive content such as secrets or paths."
  print -- "  Message excerpts are enabled by default; set EXCERPT=0 in $settings_conf_path to stop sending them."
  probe_keychain "$keychain_selector_service" && print -- '  existing v2 credential generation: will be replaced after confirmation' || print -- '  existing v2 credential generation: absent'
  classify_file "$install_bin" "$root/bin/agent-notify" executable
  classify_file "$plugin_path" "$root/integrations/opencode/agent-notify.js" OpenCode-plugin
  local link
  for link in ${(ok)unavailable_links}; do
    print -r -- "  conflict: $link is a link to an unavailable target (${(V)unavailable_links[$link]}); replacing it removes the link, and neither the backups nor --rollback bring it back"
  done
}

stage_plugin() {
  local target=$1
  "$jxa_bin" -l JavaScript "$plugin_helper" "$root/integrations/opencode/agent-notify.js" "$target" "$install_bin"
  /bin/chmod 600 "$target"
}

backup_file() {
  local source=$1 name=$2
  [[ -e $source ]] || return 0
  /bin/cp -p "$source" "$backup_dir/$name" || return 1
  print -- "$name $(mode "$source")" >> "$backup_dir/modes" || return 1
  /bin/chmod 600 "$backup_dir/$name" || return 1
  /bin/chmod 600 "$backup_dir/modes" || return 1
}

write_settings() {
  # User-editable and deliberately outside the manifest: a reinstall must not discard the choice.
  [[ -e $settings_conf_path ]] && return 0
  ( umask 077
    {
      print -- '# agent-notify settings. Reinstalling does not overwrite this file.'
      print -- '# EXCERPT=0 stops both adapters from producing message excerpts.'
      print -- "EXCERPT=$AGENT_NOTIFY_EXCERPT_DEFAULT"
    } > "$settings_conf_path"
  ) || return 1
  /bin/chmod 600 "$settings_conf_path"
}

write_manifest() {
  local staged="$backup_dir/install-manifest.json.new"
  print -r -- "{\"backup\":\"$backup_dir\",\"generation\":\"$generation\",\"files\":{\"binary\":{\"path\":\"$install_bin\",\"post_hash\":\"$bin_post_hash\",\"existed\":$bin_existed},\"library\":{\"path\":\"$install_lib\",\"post_hash\":\"$lib_post_hash\",\"existed\":$lib_existed},\"hook\":{\"path\":\"$claude_hook_path\",\"post_hash\":\"$hook_post_hash\",\"existed\":$hook_existed},\"hook_jxa\":{\"path\":\"$claude_hook_jxa_path\",\"post_hash\":\"$hook_jxa_post_hash\",\"existed\":$hook_jxa_existed},\"plugin\":{\"path\":\"$plugin_path\",\"post_hash\":\"$plugin_post_hash\",\"existed\":$plugin_existed},\"settings\":{\"path\":\"$settings_path\",\"post_hash\":\"$settings_post_hash\",\"existed\":$settings_existed}}}" > "$staged" || return 1
  /bin/chmod 600 "$staged" || return 1
  manifest_post_hash=$(sha256 "$staged") || return 1
  /bin/mv "$staged" "$manifest_path" || return 1
}

replace_library() {
  local previous="$backup_dir/lib.previous" stage_hash
  stage_hash=$(tree_hash "$stage_lib") || return 1
  if [[ -d $install_lib ]]; then /bin/mv "$install_lib" "$previous" || return 1; fi
  # Recorded only now, because the restore replaces a library matching this hash, and a failed move above leaves an identical prior library that it must not touch.
  lib_post_hash=$stage_hash
  if [[ ${AGENT_NOTIFY_INSTALL_FAIL_AT:-} == library ]]; then
    [[ -d $previous ]] && /bin/mv "$previous" "$install_lib"
    return 1
  fi
  # A directory cannot be moved over a link. This moves the link rather than removing it because a signal's restore can already have run and kept it: the backup directory is gone by then, so this fails and the link stays.
  (( ${+unavailable_links[$install_lib]} )) && [[ -L $install_lib ]] && { /bin/mv "$install_lib" "$previous" || return 1; }
  if ! /bin/mv "$stage_lib" "$install_lib"; then
    [[ -d $previous ]] && /bin/mv "$previous" "$install_lib"
    return 1
  fi
}

restore_if_unchanged() {
  local target=$1 backup=$2 post_hash=$3 existed=$4 backup_name entry saved_mode
  backup_name=${backup:t}
  [[ -e $target ]] || return 0
  [[ -n $post_hash && $(sha256 "$target") == $post_hash ]] || return 0
  if (( existed )); then
    /bin/cp -p "$backup" "$target"
    while read -r entry saved_mode; do
      [[ $entry == $backup_name ]] && { /bin/chmod "$saved_mode" "$target"; break; }
    done < "$backup_dir/modes"
  else /bin/rm -f "$target"; fi
}

rollback_attempt() {
  # A terminal interrupt also reaches the running child, so nothing may stop the restore. Without POSIX_TRAPS, zsh resets this ignore inside $(...), where the restore takes its hashes.
  setopt local_options posix_traps
  trap '' HUP INT TERM QUIT
  # zsh keeps the trap in the forked left side of a pipeline, where this flag is not shared with the main shell.
  (( completed || attempt_restored || ZSH_SUBSHELL )) && return 0
  attempt_restored=1
  [[ -n $backup_dir ]] || { cleanup_attempt; return 0; }
  restore_if_unchanged "$settings_path" "$backup_dir/settings.json" "$settings_post_hash" "$settings_existed"
  restore_if_unchanged "$plugin_path" "$backup_dir/agent-notify.js" "$plugin_post_hash" "$plugin_existed"
  if (( lib_existed )) && [[ ! -e $install_lib ]]; then
    /bin/cp -pR "$backup_dir/lib" "$install_lib"
  elif [[ -n $lib_post_hash && -d $install_lib && $(tree_hash "$install_lib") == $lib_post_hash ]]; then
    if (( lib_existed )); then /bin/rm -rf "$install_lib"; /bin/cp -pR "$backup_dir/lib" "$install_lib"; else /bin/rm -rf "$install_lib"; fi
  fi
  restore_if_unchanged "$claude_hook_jxa_path" "$backup_dir/agent-notify-claude-hook.jxa" "$hook_jxa_post_hash" "$hook_jxa_existed"
  restore_if_unchanged "$claude_hook_path" "$backup_dir/agent-notify-claude-hook" "$hook_post_hash" "$hook_existed"
  restore_if_unchanged "$install_bin" "$backup_dir/agent-notify" "$bin_post_hash" "$bin_existed"
  if [[ -n $manifest_post_hash && -e $manifest_path && $(sha256 "$manifest_path") == $manifest_post_hash ]]; then
    if (( manifest_existed )); then
      /bin/cp -p "$backup_dir/install-manifest.json" "$manifest_path"
      local entry saved_mode
      while read -r entry saved_mode; do [[ $entry == install-manifest.json ]] && { /bin/chmod "$saved_mode" "$manifest_path"; break; }; done < "$backup_dir/modes"
    else
      /bin/rm -f "$manifest_path"
    fi
  fi
  # A replaced link has no backup, since nothing behind it could be read.
  local link
  for link in ${(k)unavailable_links}; do
    [[ -e $link || -L $link ]] || /bin/ln -s -- "${unavailable_links[$link]}" "$link" || true
  done
  [[ -n $generation ]] && print -rn -- "{\"generation\":\"$generation\",\"selector\":\"$selector_before\"}" | "$jxa_bin" -l JavaScript "$keychain_helper" rollback || true
  cleanup_attempt
  print -u2 -- 'agent-notify-install: installation failed; restored only unchanged attempt artifacts'
}

install() {
  local stage_bin stage_lib stage_hook stage_hook_jxa stage_plugin_file stage_settings
  confirm 'Proceed with the displayed plan?' || { print -- 'Installation declined; no changes made.'; return 0; }
  has_conflict && ! confirm 'Replace conflicting installer target(s)?' && die 'conflicting target not replaced'
  read_secret_tty 'Pushover user key: ' || die 'unable to read user key from /dev/tty'
  user_key=$REPLY
  read_secret_tty 'Pushover application token: ' || die 'unable to read application token from /dev/tty'
  app_token=$REPLY
  [[ -n $user_key && -n $app_token ]] || die 'both credentials are required'
  if [[ ! -d $backup_root ]]; then
    # A signal can stop the installer after any line here, and only this flag lets the cleanup remove the directory. Later installs never change its mode, so it is created private.
    backup_root_created=1
    /bin/mkdir -p "${backup_root:h}" || return 1
    /bin/mkdir -m 700 "$backup_root" || return 1
  fi
  backup_dir=$(/usr/bin/mktemp -d "$backup_root/install.XXXXXX") || return 1
  /bin/chmod 700 "$backup_dir" || return 1
  [[ -e $manifest_path ]] && { manifest_existed=1; backup_file "$manifest_path" install-manifest.json || return 1; }
  backup_file "$install_bin" agent-notify || return 1
  [[ -d $install_lib ]] && /bin/cp -pR "$install_lib" "$backup_dir/lib" || [[ ! -d $install_lib ]] || return 1
  backup_file "$claude_hook_path" agent-notify-claude-hook || return 1
  backup_file "$claude_hook_jxa_path" agent-notify-claude-hook.jxa || return 1
  backup_file "$plugin_path" agent-notify.js || return 1
  backup_file "$settings_path" settings.json || return 1
  stage_bin="$backup_dir/agent-notify.new"; stage_lib="$backup_dir/lib.new"; stage_hook="$backup_dir/agent-notify-claude-hook.new"; stage_hook_jxa="$backup_dir/agent-notify-claude-hook.jxa.new"; stage_plugin_file="$backup_dir/agent-notify.js.new"; stage_settings="$backup_dir/settings.json.new"
  /bin/cp "$root/bin/agent-notify" "$stage_bin" || return 1; /bin/chmod 700 "$stage_bin" || return 1
  /bin/cp -pR "$root/lib/agent-notify" "$stage_lib" || return 1
  /bin/cp "$root/integrations/claude/agent-notify-hook.zsh" "$stage_hook" || return 1; /bin/chmod 700 "$stage_hook" || return 1
  /bin/cp "$root/integrations/claude/agent-notify-hook.jxa" "$stage_hook_jxa" || return 1; /bin/chmod 600 "$stage_hook_jxa" || return 1
  stage_plugin "$stage_plugin_file" || return 1
  "$jxa_bin" -l JavaScript "$settings_helper" merge "$settings_path" "$stage_settings" "$command_prefix" || return 1
  [[ $("$jxa_bin" -l JavaScript "$settings_helper" inspect "$stage_settings" - "$command_prefix") == valid ]] || die 'generated Claude settings failed validation'
  generation="$(/bin/date +%s)-$RANDOM"
  # The v2 selector is non-secret generation metadata. Reading it is required
  # only to restore a previous v2 selector if a later file mutation fails.
  # security exits 44 when the item is missing. Any other failure leaves the prior selector unknown, and a rollback that restores an empty one deletes it.
  selector_before=$("$security_bin" find-generic-password -a "$keychain_account" -s "$keychain_selector_service" -w 2>/dev/null) || {
    (( $? == 44 )) || die 'unable to read the current Keychain selector; nothing was installed'
    selector_before=''
  }
  mutation_started=1
  # A refusal below prints before any restore, and with nobody to read it, SIGPIPE would otherwise leave the attempt half done.
  trap '' PIPE
  trap rollback_attempt EXIT HUP INT TERM
  # A signal right after the trap has already restored, so the store below would never be rolled back.
  (( attempt_restored )) && return 1
  local store_status=0
  print -rn -- "{\"generation\":\"$generation\",\"user\":\"$user_key\",\"token\":\"$app_token\"}" | "$jxa_bin" -l JavaScript "$keychain_helper" store || store_status=$?
  # A signal after the check above restores before the store has run, which leaves the store with nothing to undo it. Rolling back again removes nothing that should stay, and is merely redundant after a signal during the store, whose trap runs once the store has finished.
  if (( attempt_restored )); then
    print -rn -- "{\"generation\":\"$generation\",\"selector\":\"$selector_before\"}" | "$jxa_bin" -l JavaScript "$keychain_helper" rollback || true
    return 1
  fi
  (( ! store_status )) || return 1
  [[ ${AGENT_NOTIFY_INSTALL_FAIL_AT:-} == keychain ]] && return 1
  local bin_dir_existed=0 plugin_dir_existed=0
  mark_new_directory "${install_bin:h}"
  mark_new_directory "${install_lib:h}"
  mark_new_directory "${plugin_path:h}"
  mark_new_directory "${settings_path:h}"
  [[ -d ${install_bin:h} ]] && bin_dir_existed=1
  [[ -d ${plugin_path:h} ]] && plugin_dir_existed=1
  /bin/mkdir -p "${install_bin:h}" "${install_lib:h}" "${plugin_path:h}" "${settings_path:h}" || return 1
  (( bin_dir_existed )) || /bin/chmod 700 "${install_bin:h}" || return 1
  (( plugin_dir_existed )) || /bin/chmod 700 "${plugin_path:h}" || return 1
  [[ -e $install_bin ]] && bin_existed=1; [[ -d $install_lib ]] && lib_existed=1; [[ -e $claude_hook_path ]] && hook_existed=1; [[ -e $claude_hook_jxa_path ]] && hook_jxa_existed=1; [[ -e $plugin_path ]] && plugin_existed=1
  # Each hash is recorded before its move: the restore acts only on recorded hashes, so a signal must never find an installed artifact without one.
  bin_post_hash=$(sha256 "$stage_bin") || return 1; /bin/mv "$stage_bin" "$install_bin" || return 1
  replace_library || return 1
  hook_post_hash=$(sha256 "$stage_hook") || return 1; /bin/mv "$stage_hook" "$claude_hook_path" || return 1
  hook_jxa_post_hash=$(sha256 "$stage_hook_jxa") || return 1; /bin/mv "$stage_hook_jxa" "$claude_hook_jxa_path" || return 1
  [[ ${AGENT_NOTIFY_INSTALL_FAIL_AT:-} == binary ]] && return 1
  plugin_post_hash=$(sha256 "$stage_plugin_file") || return 1; /bin/mv "$stage_plugin_file" "$plugin_path" || return 1
  [[ ${AGENT_NOTIFY_INSTALL_FAIL_AT:-} == plugin ]] && return 1
  # Done before the check below, so a change to settings during this time is refused rather than overwritten.
  local stage_settings_hash
  /bin/chmod 600 "$stage_settings" || return 1; stage_settings_hash=$(sha256 "$stage_settings") || return 1
  if [[ ${AGENT_NOTIFY_INSTALL_TEST_CREATE_SETTINGS_BEFORE_RENAME:-0} == 1 && ! -e $settings_path ]]; then
    print -- '{}' > "$settings_path" || return 1
  fi
  if (( settings_existed )); then
    local preimage expected_preimage
    [[ -e $settings_path ]] || { print -u2 -- 'agent-notify-install: Claude settings disappeared during installation; refusing to overwrite'; return 1; }
    preimage=$(sha256 "$settings_path")
    expected_preimage=$(sha256 "$backup_dir/settings.json")
    [[ $preimage == $expected_preimage ]] || { print -u2 -- 'agent-notify-install: Claude settings changed during installation; refusing to overwrite'; return 1; }
  elif [[ -e $settings_path ]]; then
    print -u2 -- 'agent-notify-install: Claude settings appeared during installation; refusing to overwrite'
    return 1
  fi
  settings_post_hash=$stage_settings_hash; /bin/mv "$stage_settings" "$settings_path" || return 1
  [[ ${AGENT_NOTIFY_INSTALL_FAIL_AT:-} == settings ]] && return 1
  [[ -d $state_dir ]] && state_dir_existed=1 || mark_new_directory "$state_dir"
  /bin/mkdir -p "$state_dir" || return 1
  (( state_dir_existed )) || /bin/chmod 700 "$state_dir" || return 1
  write_manifest || return 1
  # The install commits here. A signal after this line finds it finished, and one before it has restored the home, which the check below sees.
  completed=1
  (( attempt_restored )) && return 1
  # Nothing else would remove the prior generation, so a signal must not stop the retire below.
  trap '' HUP INT TERM QUIT
  trap - EXIT
  # Both steps run before either warning, because a warning with nobody to read it can stop whatever comes after it.
  local retire_failed=0 settings_failed=0
  if [[ -n $selector_before ]] && ! print -rn -- "{\"previous\":\"$selector_before\"}" | "$jxa_bin" -l JavaScript "$keychain_helper" retire; then retire_failed=1; fi
  write_settings || settings_failed=1
  (( retire_failed )) && print -u2 -- "agent-notify-install: installed successfully, but prior v2 Keychain generation $selector_before could not be retired; remove it manually after verifying delivery"
  (( settings_failed )) && print -u2 -- "agent-notify-install: installed successfully, but $settings_conf_path could not be created; excerpts stay enabled"
  print -- 'agent-notify installation complete:'
  print -- "  notifier: $install_bin"
  print -- "  Claude hook adapter: $claude_hook_path"
  print -- "  plugin: $plugin_path"
  print -- "  settings: $settings_path"
  print -- "  Claude hook JXA: $claude_hook_jxa_path"
  print -- "  backups: $backup_dir"
  local link
  for link in ${(ok)unavailable_links}; do
    print -r -- "  replaced link: $link (it pointed to ${(V)unavailable_links[$link]}; the backups and --rollback do not restore it)"
  done
  print -- "  manifest: $manifest_path"
  print -- "  excerpt settings: $settings_conf_path"
  print -- "  installed hashes: notifier=$bin_post_hash library=$lib_post_hash plugin=$plugin_post_hash settings=$settings_post_hash"
  print -- "  smoke test: $install_bin smoke-test"
  print -- "  rollback: $root/bin/agent-notify-install --rollback (restores only artifacts whose hashes still match this install; changed files are left in place and reported)"
}

rollback() {
  [[ -r $manifest_path ]] || die 'no installation manifest found'
  local binary library hook hook_jxa plugin settings generation_value previous_generation backup post existed backup_name entry saved_mode
  binary=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.binary.path)
  library=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.library.path)
  hook=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.hook.path)
  hook_jxa=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.hook_jxa.path)
  plugin=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.plugin.path)
  settings=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.settings.path)
  backup=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" backup)
  generation_value=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" generation)
  previous_generation=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" previous_generation 2>/dev/null || true)
  for label in binary hook hook_jxa plugin; do
    post=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" "files.$label.post_hash")
    existed=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" "files.$label.existed")
    local target=${(P)label}
    case $label in binary) backup_name=agent-notify;; hook) backup_name=agent-notify-claude-hook;; hook_jxa) backup_name=agent-notify-claude-hook.jxa;; plugin) backup_name=agent-notify.js;; esac
    if [[ -e $target && ! -L $target && $(sha256 "$target") == $post ]]; then
      if [[ $existed == true ]]; then
        /bin/cp -p "$backup/$backup_name" "$target"
        while read -r entry saved_mode; do [[ $entry == $backup_name ]] && { /bin/chmod "$saved_mode" "$target"; break; }; done < "$backup/modes"
      else
        /bin/rm -f "$target"
      fi
    else
      print -u2 -- "rollback: left externally changed $label in place"
    fi
  done
  post=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.library.post_hash)
  local library_existed
  library_existed=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.library.existed)
  if [[ -d $library && ! -L $library && $(tree_hash "$library") == $post ]]; then
    /bin/rm -rf "$library"
    [[ $library_existed == true ]] && /bin/cp -pR "$backup/lib" "$library"
  else print -u2 -- 'rollback: left externally changed library in place'; fi
  local settings_existed_before
  post=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.settings.post_hash)
  settings_existed_before=$("$jxa_bin" -l JavaScript "$manifest_helper" "$manifest_path" files.settings.existed)
  if [[ -e $settings && ! -L $settings && $(sha256 "$settings") == $post ]]; then
    if [[ $settings_existed_before == true ]]; then
      /bin/cp -p "$backup/settings.json" "$settings"
      while read -r entry saved_mode; do [[ $entry == settings.json ]] && { /bin/chmod "$saved_mode" "$settings"; break; }; done < "$backup/modes"
    else
      /bin/rm -f "$settings"
    fi
  elif [[ $settings_existed_before == true && -e $hook ]]; then
    print -u2 -- "rollback: left changed Claude settings in place; compare them with $backup/settings.json, and remove commands beginning with $command_prefix only if the notifier is no longer wanted"
  else
    print -u2 -- "rollback: left changed Claude settings in place; manually remove commands beginning with $command_prefix"
  fi
  if confirm 'Also remove the Pushover credentials from Keychain?'; then
    print -rn -- "{\"generation\":\"$generation_value\",\"previous\":\"$previous_generation\"}" | "$jxa_bin" -l JavaScript "$keychain_helper" remove
  fi
  print -- 'Selective rollback complete.'
}

while (( $# )); do case $1 in --dry-run) dry_run=1;; --rollback) rollback=1;; *) usage; exit 2;; esac; shift; done
if (( dry_run && rollback )); then usage; exit 2; fi
trap cleanup_attempt EXIT INT TERM
if (( rollback )); then rollback_preflight; rollback; exit 0; fi
trap stop_before_mutation HUP INT TERM
preflight
preview
(( dry_run )) && { print -- 'Dry run complete; no credentials collected and no changes made.'; exit 0; }
set +e
install
install_status=$?
set -e
if (( install_status )); then
  rollback_attempt
  trap - EXIT INT TERM
  exit 1
fi
