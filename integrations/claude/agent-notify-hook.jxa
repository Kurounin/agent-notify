#!/usr/bin/osascript -l JavaScript

ObjC.import('Foundation');

const MAX_EXCERPT_GRAPHEMES = 200;
const MAX_EXCERPT_LENGTH = 240;
const MAX_EXCERPT_BYTES = 700;
const EXCERPT_TRUNCATION_MARKER = '…';
const EXCERPT_CODE_MARKER = '[code]';
const SETTINGS_RELATIVE_PATH = '/Library/Application Support/agent-notify/settings.conf';
const EXCERPT_DISABLED = /^[ \t]*EXCERPT[ \t]*=[ \t]*0[ \t]*$/m;
// Escape payloads go before ESC itself becomes a deletable control character, and line breaks
// become spaces before the remaining control characters are deleted, or their text runs together.
const ANSI_ESCAPE = /\x1b\][\s\S]*?(?:\x07|\x1b\\)|\x1b\[[0-?]*[ -\/]*[@-~]|\x1b[@-Z\\-_]/g;
const LINE_BREAK = new RegExp('[\\u000a\\u000b\\u000c\\u000d\\u0085\\u2028\\u2029]', 'g');
const CONTROL = /[\x00-\x1f\x7f-\x9f]/g;
// Bidirectional and zero-width formatting can rewrite how the notification renders. ZWJ and VS16
// stay because removing them breaks emoji.
const INVISIBLE = new RegExp('[\\u061c\\u200b\\u200c\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069\\ufeff]', 'g');
const CODE_FENCE = /```[\s\S]*?```/g;
const BACKTICKS = /`+/g;
const MAX_CONTEXT_LENGTH = 256;
const MAX_TMUX_OUTPUT_BYTES = 1024;
const TMUX_TIMEOUT_SECONDS = 0.5;
const C0_OR_DEL = /[\x00-\x1f\x7f]/;
const TMUX_PANE = /^%[0-9]{1,255}$/;

const processArguments = $.NSProcessInfo.processInfo.arguments;
const args = [];
for (let index = 0; index < processArguments.count; index += 1) args.push(ObjC.unwrap(processArguments.objectAtIndex(index)));
const event = args[4];
const rawData = $.NSFileHandle.fileHandleWithStandardInput.readDataToEndOfFile;
const raw = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(rawData, $.NSUTF8StringEncoding));

function output(value) {
  $.NSFileHandle.fileHandleWithStandardOutput.writeData($(value + '\n').dataUsingEncoding($.NSUTF8StringEncoding));
}

function value(object, names) {
  for (const name of names) {
    if (typeof object[name] === 'string' && object[name].length > 0) return object[name];
  }
  return undefined;
}

function validContext(value) {
  return typeof value === 'string' && value.length > 0 && value.length <= MAX_CONTEXT_LENGTH && !C0_OR_DEL.test(value);
}

function firstValidContext(values) {
  for (const candidate of values) {
    if (validContext(candidate)) return candidate;
  }
  return undefined;
}

function environmentValue(name) {
  const candidate = ObjC.unwrap($.NSProcessInfo.processInfo.environment.objectForKey(name));
  return typeof candidate === 'string' ? candidate : undefined;
}

let tmuxLookup;
ObjC.registerSubclass({
  name: 'AgentNotifyTmuxOutputObserver',
  methods: {
    'handleOutput:': {
      types: ['void', ['id']],
      implementation(notification) {
        if (!tmuxLookup || tmuxLookup.finished) return;
        const data = notification.userInfo.objectForKey($.NSFileHandleNotificationDataItem);
        const length = Number(data.length);
        if (length === 0) {
          tmuxLookup.eof = true;
          return;
        }

        if (tmuxLookup.bytes + length > MAX_TMUX_OUTPUT_BYTES) {
          tmuxLookup.overflow = true;
          tmuxLookup.finished = true;
          if (tmuxLookup.task.isRunning) tmuxLookup.task.terminate();
          return;
        }

        tmuxLookup.output.appendData(data);
        tmuxLookup.bytes += length;
        notification.object.readInBackgroundAndNotify;
      },
    },
  },
});

function tmuxSessionForEvent() {
  if (!['attention', 'completed', 'failed'].includes(event)) return undefined;

  const tmux = environmentValue('TMUX');
  const pane = environmentValue('TMUX_PANE');
  const executable = environmentValue('AGENT_NOTIFY_TMUX_PATH');
  if (!tmux || !TMUX_PANE.test(pane) || typeof executable !== 'string' || !executable.startsWith('/')) return undefined;

  let task;
  let handle;
  let observer;
  try {
    const pipe = $.NSPipe.pipe;
    handle = pipe.fileHandleForReading;
    task = $.NSTask.alloc.init;
    task.setLaunchPath(executable);
    task.setArguments(['display-message', '-p', '-t', pane, '#S']);
    task.setStandardOutput(pipe);
    task.setStandardError($.NSFileHandle.fileHandleWithNullDevice);

    tmuxLookup = { task, output: $.NSMutableData.data, bytes: 0, eof: false, overflow: false, finished: false };
    observer = $.AgentNotifyTmuxOutputObserver.alloc.init;
    $.NSNotificationCenter.defaultCenter.addObserverSelectorNameObject(observer, 'handleOutput:', $.NSFileHandleReadCompletionNotification, handle);
    handle.readInBackgroundAndNotify;
    task.launch;

    const deadline = $.NSDate.dateWithTimeIntervalSinceNow(TMUX_TIMEOUT_SECONDS);
    while ((task.isRunning || !tmuxLookup.eof) && !tmuxLookup.finished && deadline.timeIntervalSinceNow > 0) {
      $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.01));
    }

    if (tmuxLookup.overflow) {
      while (task.isRunning && deadline.timeIntervalSinceNow > 0) {
        $.NSRunLoop.currentRunLoop.runUntilDate($.NSDate.dateWithTimeIntervalSinceNow(0.01));
      }
      return undefined;
    }
    if (!tmuxLookup.finished && (task.isRunning || !tmuxLookup.eof)) {
      tmuxLookup.finished = true;
      if (task.isRunning) task.terminate();
      return undefined;
    }
    if (tmuxLookup.overflow || task.terminationStatus !== 0) return undefined;

    const text = ObjC.unwrap($.NSString.alloc.initWithDataEncoding(tmuxLookup.output, $.NSUTF8StringEncoding));
    const session = typeof text === 'string' && text.endsWith('\n') ? text.slice(0, -1) : text;
    return validContext(session) ? session : undefined;
  } catch (_) {
    if (task && task.isRunning) task.terminate();
    return undefined;
  } finally {
    if (observer) $.NSNotificationCenter.defaultCenter.removeObserver(observer);
    tmuxLookup = undefined;
  }
}

function settingsPath() {
  const override = ObjC.unwrap($.NSProcessInfo.processInfo.environment.objectForKey('AGENT_NOTIFY_SETTINGS_FILE'));
  if (typeof override === 'string' && override.length > 0) return override;
  return ObjC.unwrap($.NSHomeDirectory()) + SETTINGS_RELATIVE_PATH;
}

// The hook is a fresh process per event, so reading the file here already honours a change made
// while the session is running.
function excerptsEnabled() {
  try {
    const contents = ObjC.unwrap($.NSString.stringWithContentsOfFileEncodingError(settingsPath(), $.NSUTF8StringEncoding, null));
    if (typeof contents !== 'string') return true;
    return !EXCERPT_DISABLED.test(contents);
  } catch (_) {
    // An absent, unreadable, or malformed settings file leaves excerpts enabled.
    return true;
  }
}

function sanitizeExcerpt(text) {
  return text
    .normalize('NFC')
    .replace(ANSI_ESCAPE, '')
    .replace(LINE_BREAK, ' ')
    .replace(CONTROL, '')
    .replace(INVISIBLE, '')
    .replace(CODE_FENCE, EXCERPT_CODE_MARKER)
    .replace(BACKTICKS, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function utf8ByteLength(text) {
  let bytes = 0;
  for (const character of text) {
    const codePoint = character.codePointAt(0);
    bytes += codePoint <= 0x7f ? 1 : codePoint <= 0x7ff ? 2 : codePoint <= 0xffff ? 3 : 4;
  }
  return bytes;
}

function graphemeClusters(text) {
  const clusters = [];
  for (const cluster of new Intl.Segmenter(undefined, { granularity: 'grapheme' }).segment(text)) clusters.push(cluster.segment);
  return clusters;
}

function boundExcerpt(text) {
  if (text.length === 0) return '';
  const clusters = graphemeClusters(text);
  if (clusters.length <= MAX_EXCERPT_GRAPHEMES && text.length <= MAX_EXCERPT_LENGTH && utf8ByteLength(text) <= MAX_EXCERPT_BYTES) return text;

  const maxGraphemes = MAX_EXCERPT_GRAPHEMES - 1;
  const maxUnits = MAX_EXCERPT_LENGTH - EXCERPT_TRUNCATION_MARKER.length;
  const maxBytes = MAX_EXCERPT_BYTES - utf8ByteLength(EXCERPT_TRUNCATION_MARKER);
  let graphemes = 0;
  let units = 0;
  let bytes = 0;
  let index = clusters.length;
  while (index > 0) {
    const cluster = clusters[index - 1];
    const clusterBytes = utf8ByteLength(cluster);
    if (graphemes + 1 > maxGraphemes || units + cluster.length > maxUnits || bytes + clusterBytes > maxBytes) break;
    graphemes += 1;
    units += cluster.length;
    bytes += clusterBytes;
    index -= 1;
  }
  return EXCERPT_TRUNCATION_MARKER + clusters.slice(index).join('');
}

// Pinned to two fields by name: the same payload also carries background task commands and cron
// prompts, which a generalized search for text would leak.
function excerptFrom(payload) {
  try {
    if (event !== 'completed' && event !== 'failed') return undefined;
    if (!excerptsEnabled()) return undefined;
    const source = event === 'failed' ? payload.error : payload.last_assistant_message;
    if (typeof source !== 'string' || source.length === 0) return undefined;
    return boundExcerpt(sanitizeExcerpt(source)) || undefined;
  } catch (_) {
    // An excerpt failure must never suppress the event that carried it.
    return undefined;
  }
}

try {
  const payload = JSON.parse(raw);
  const agentType = payload.agent_type || payload.agentType || payload.agent?.type;
  if (payload.is_background === true || payload.is_subagent === true || payload.agent?.is_background === true || payload.agent?.is_subagent === true || payload.parent_tool_use_id || ['subagent', 'background', 'background_agent'].includes(agentType)) throw new Error('ignored non-main agent');
  if (agentType && !['main', 'main_agent'].includes(agentType)) throw new Error('ignored agent type');
  const sessionID = value(payload, ['session_id', 'sessionId']);
  const sessionDir = firstValidContext([environmentValue('CLAUDE_PROJECT_DIR'), payload.session_dir, payload.cwd, payload.directory]);
  if (!sessionID || !sessionDir) throw new Error('ignored incomplete payload');
  if (event === 'attention' && !['permission_prompt', 'elicitation_dialog', 'elicitation_url_dialog'].includes(payload.notification_type)) throw new Error('ignored notification type');
  // Claude stops the turn while background work stays registered, then wakes the session when it
  // settles; that later Stop reports an empty list and carries the completion.
  if (event === 'completed' && Array.isArray(payload.background_tasks) && payload.background_tasks.length > 0) throw new Error('ignored completion pending background work');
  const normalized = { source: 'claude-code', kind: event, session_id: sessionID, session_dir: sessionDir };
  const requestID = value(payload, ['request_id', 'requestId', 'notification_id']) || (event === 'attention' ? `claude-notification:${sessionID}:${payload.notification_type}` : undefined);
  if (requestID) normalized.request_id = requestID;
  const excerpt = excerptFrom(payload);
  if (excerpt) normalized.excerpt = excerpt;
  const tmuxSession = tmuxSessionForEvent();
  if (tmuxSession) normalized.tmux_session = tmuxSession;
  output(JSON.stringify(normalized));
} catch (_) {
  // Hooks are advisory: malformed payloads must not change Claude execution.
}
