{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_NOTIFY_CLAUDE_HOOK__ # agent-notify:claude-hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_NOTIFY_CLAUDE_HOOK__ # agent-notify:claude-hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_NOTIFY_CLAUDE_HOOK__ # agent-notify:claude-hook"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__AGENT_NOTIFY_CLAUDE_HOOK__ # agent-notify:claude-hook"
          }
        ]
      }
    ]
  }
}
